{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "images", "prepare", "install", "recovery", "current"],
  "properties": {
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sha256",
          "application_size",
          "application_offset",
          "flash_size",
          "features",
          "validation",
          "payload_size",
          "erase_size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "application_size": {
            "type": "integer",
            "minimum": 1
          },
          "application_offset": {
            "type": "integer",
            "minimum": 0
          },
          "flash_size": {
            "type": "integer",
            "minimum": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "payload_size": {
            "type": "integer",
            "enum": [25600, 26624, 32768, 54272]
          },
          "erase_size": {
            "type": "integer",
            "const": 54272
          }
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "sources"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
          }
        }
      }
    },
    "install": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "documentation"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["stock", "dt02", "cl01", "rs01-r7", "tb01", "fp01", "tr01"]
        },
        "profile": {
          "type": "string",
          "const": "STM32F030C8T6-8KiB-exact-R7"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
