{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "images",
    "prepare",
    "install",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sha256",
          "application_size",
          "application_offset",
          "flash_size",
          "features",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "stock",
              "dt02",
              "cl01",
              "rs01-r7"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "application_size": {
            "type": "integer",
            "minimum": 1
          },
          "application_offset": {
            "type": "integer",
            "minimum": 0
          },
          "flash_size": {
            "type": "integer",
            "minimum": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "validation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dt02",
        "cl01",
        "rs01-r7"
      ],
      "properties": {
        "dt02": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stock",
              "dt02",
              "cl01",
              "rs01-r7"
            ]
          },
          "uniqueItems": true
        },
        "cl01": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stock",
              "dt02",
              "cl01",
              "rs01-r7"
            ]
          },
          "uniqueItems": true
        },
        "rs01-r7": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stock",
              "dt02",
              "cl01",
              "rs01-r7"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "install": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "enum": [
            "stock",
            "dt02",
            "cl01",
            "rs01-r7"
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "documentation"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "stock",
            "dt02",
            "cl01",
            "rs01-r7"
          ]
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
