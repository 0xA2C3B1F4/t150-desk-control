{
  "name": "desk_protocol",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Platform-independent UART library for the Deltaco Gaming DT410 / GAM-140 desk with a T150-22-03-PJ enclosure and T150-PJ-V1.5 controller PCB",
  "build": {
    "includeDir": "components/desk_uart",
    "srcDir": "components/desk_uart/desk_protocol",
    "srcFilter": "-<*>"
  },
  "frameworks": "*",
  "platforms": "*",
  "export": {
    "include": [
      "library.json",
      "LICENSE",
      "README.md",
      "lib/desk_protocol/CMakeLists.txt",
      "components/desk_uart/desk_protocol/child_lock.h",
      "components/desk_uart/desk_protocol/custom_timer_buzzer.h",
      "components/desk_uart/desk_protocol/direct_target.h",
      "components/desk_uart/desk_protocol/display_settings.h",
      "components/desk_uart/desk_protocol/firmware_export.h",
      "components/desk_uart/desk_protocol/firmware_install.h",
      "components/desk_uart/desk_protocol/firmware_layout.h",
      "components/desk_uart/desk_protocol/firmware_profile.h",
      "components/desk_uart/desk_protocol/height_profile.h",
      "components/desk_uart/desk_protocol/identity.h",
      "components/desk_uart/desk_protocol/motion_trim.h",
      "components/desk_uart/desk_protocol/preset_journal.h",
      "components/desk_uart/desk_protocol/presets.h",
      "components/desk_uart/desk_protocol/protocol.h",
      "components/desk_uart/desk_protocol/reset_speed.h",
      "components/desk_uart/desk_protocol/target.h",
      "components/desk_uart/desk_protocol/target_detection.h",
      "components/desk_uart/desk_protocol/timer.h",
      "components/desk_uart/desk_protocol/uart_observation.h"
    ]
  }
}
